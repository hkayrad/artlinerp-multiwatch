Options -Indexes

# Prevent search engine indexing, caching, and AI training across all pages & uploaded images
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block known AI crawlers and scrapers from pages, APIs, and fanart images
  RewriteCond %{REQUEST_URI} !^/robots\.txt$
  RewriteCond %{HTTP_USER_AGENT} (GPTBot|ChatGPT-User|OAI-SearchBot|Google-Extended|CCBot|anthropic-ai|ClaudeBot|Claude-Web|PerplexityBot|Perplexity-User|Bytespider|Applebot-Extended|FacebookBot|Meta-ExternalAgent|Amazonbot|cohere-ai|Diffbot|Omgilibot|YouBot|Timpibot|ImagesiftBot|PetalBot|AI2Bot) [NC]
  RewriteRule ^ - [F,L]

  # Allow PHP API and approved uploaded images directly
  RewriteRule ^api/ - [L]
  RewriteRule ^uploads/ - [L]

  # Block direct access to internal JSON data directory
  RewriteRule ^fanart-data/ - [F,L]

  # Serve existing files and directories normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback for /, /fanart, /admin
  RewriteRule ^ index.html [L]
</IfModule>
